<Window x:Class="StarryDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starry Display"
        Width="1000" Height="400" MinWidth="360" MinHeight="110"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Grid x:Name="Root" Background="Transparent" MouseLeftButtonDown="OnRootMouseDown">
        <ContentControl x:Name="Host" Focusable="False" />
        <ContentControl x:Name="SetupHost" Focusable="False" Visibility="Collapsed" />

        <!-- Hover toolbar. Hidden while locked (click-through). -->
        <StackPanel x:Name="Toolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,14,0" Opacity="0" IsHitTestVisible="False">
            <Button x:Name="LayoutButton" Style="{StaticResource IconButton}" Content="&#xE73F;" ToolTip="Switch layout" Margin="0,0,6,0" Click="OnToolbar" Tag="layout" />
            <Button Style="{StaticResource IconButton}" Content="&#xE7FC;" ToolTip="Gaming overlay" Margin="0,0,6,0" Click="OnToolbar" Tag="overlay" />
            <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" ToolTip="Always on top" Margin="0,0,6,0" Click="OnToolbar" Tag="topmost" />
            <Button Style="{StaticResource IconButton}" Content="&#xE72E;" ToolTip="Click-through" Margin="0,0,6,0" Click="OnToolbar" Tag="lock" />
            <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Margin="0,0,6,0" Click="OnToolbar" Tag="settings" />
            <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Hide to tray" Click="OnToolbar" Tag="hide" />
        </StackPanel>
    </Grid>
</Window>
