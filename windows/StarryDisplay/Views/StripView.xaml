<UserControl x:Class="StarryDisplay.Views.StripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#01000000"
             TextOptions.TextFormattingMode="Ideal">
    <!-- Background is 1/255 alpha: invisible, but keeps the strip draggable when unlocked. -->
    <Grid>
        <Border x:Name="LyricsHost" Margin="20,26,20,6">
            <Border.Effect>
                <!-- Keeps light text legible over any wallpaper or game. -->
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.9" Color="Black" RenderingBias="Performance" />
            </Border.Effect>
        </Border>

        <!-- Track pill: appears on hover and briefly on each track change. -->
        <Border x:Name="Header" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"
                CornerRadius="13" Background="#B30A0D18" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                Padding="4,4,12,4" Opacity="0" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Border Width="18" Height="18" CornerRadius="4" ClipToBounds="True">
                    <Image x:Name="Thumb" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock x:Name="HeaderText" FontFamily="{StaticResource TextFont}" FontSize="12" Margin="8,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource InkSoftBrush}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
