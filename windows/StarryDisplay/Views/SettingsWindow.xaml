<Window x:Class="StarryDisplay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starry Display settings"
        Width="520" Height="640" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#12151F"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource TextFont}">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="2,22,0,8" />
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <!-- One cell of the 3x3 overlay position picker. -->
        <Style x:Key="AnchorCell" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Cell" Margin="2" CornerRadius="4" Background="#14FFFFFF" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="#9FB4FF" />
                                <Setter TargetName="Cell" Property="BorderBrush" Value="#9FB4FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,24">
            <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="24" Foreground="{StaticResource InkBrush}" />

            <TextBlock Text="Spotify" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Section}">
                <DockPanel>
                    <Button x:Name="AccountButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Click="OnAccount" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AccountText" Style="{StaticResource Label}" />
                        <TextBlock x:Name="AccountHint" Style="{StaticResource Hint}" Margin="0,2,12,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="Display" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="Layout" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <RadioButton x:Name="StageRadio" Content="Stage card" Style="{StaticResource RadioPill}" GroupName="Layout" Checked="OnChanged" />
                        <RadioButton x:Name="StripRadio" Content="Lyrics strip" Style="{StaticResource RadioPill}" GroupName="Layout" Checked="OnChanged" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Stage: artwork, details and a scrolling lyric sheet. Strip: two floating lines for over games and windows." />

                    <CheckBox x:Name="TopmostBox" Content="Always on top" Style="{StaticResource ToggleSwitch}" Margin="0,16,0,0" Click="OnChanged" />
                    <CheckBox x:Name="BackdropBox" Content="Artwork glow behind the card" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0" Click="OnChanged" />

                    <TextBlock Text="Lyrics size" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Slider x:Name="LyricsSlider" Style="{StaticResource FlatSlider}" Minimum="0.7" Maximum="1.6" ValueChanged="OnSliderChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="Gaming overlay" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="Show" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <RadioButton x:Name="DesktopRadio" Content="Desktop display" Style="{StaticResource RadioPill}" GroupName="Presentation" Checked="OnChanged" />
                        <RadioButton x:Name="OverlayRadio" Content="Gaming overlay" Style="{StaticResource RadioPill}" GroupName="Presentation" Checked="OnChanged" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="A small card that stays above borderless and windowed games, lets clicks through and never takes focus. Games in exclusive fullscreen draw over every window; switch them to borderless." />

                    <TextBlock Text="Monitor" Style="{StaticResource Label}" Margin="0,16,0,8" />
                    <WrapPanel x:Name="MonitorPanel" />

                    <DockPanel Margin="0,16,0,0">
                        <Grid x:Name="AnchorGrid" DockPanel.Dock="Left" Width="90" Height="56" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        </Grid>
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="Position" Style="{StaticResource Label}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,8" Text="Pick a spot, or turn click-through off and drag the overlay where you want it." />
                            <Button x:Name="ResetOffsetButton" Content="Snap to spot" Style="{StaticResource PillButton}" Height="28" HorizontalAlignment="Left" Click="OnResetOverlayOffset" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Detail" Style="{StaticResource Label}" Margin="0,16,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="MinimalRadio" Content="Lyric only" Style="{StaticResource RadioPill}" GroupName="Density" Checked="OnChanged" />
                        <RadioButton x:Name="CompactRadio" Content="Compact" Style="{StaticResource RadioPill}" GroupName="Density" Checked="OnChanged" />
                        <RadioButton x:Name="FullRadio" Content="Full" Style="{StaticResource RadioPill}" GroupName="Density" Checked="OnChanged" />
                    </StackPanel>

                    <CheckBox x:Name="OverlayLyricsBox" Content="Lyrics" Style="{StaticResource ToggleSwitch}" Margin="0,16,0,0" Click="OnChanged" />
                    <CheckBox x:Name="OverlayArtBox" Content="Artwork" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0" Click="OnChanged" />
                    <CheckBox x:Name="OverlayClickBox" Content="Click-through (clicks go to the game)" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0" Click="OnChanged" />
                    <CheckBox x:Name="OverlayTopBox" Content="Always on top" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0" Click="OnChanged" />

                    <TextBlock Text="Size" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Slider x:Name="OverlayScaleSlider" Style="{StaticResource FlatSlider}" Minimum="0.6" Maximum="1.6" ValueChanged="OnSliderChanged" />
                    <TextBlock Text="Opacity" Style="{StaticResource Label}" Margin="0,14,0,6" />
                    <Slider x:Name="OverlayOpacitySlider" Style="{StaticResource FlatSlider}" Minimum="0.3" Maximum="1" ValueChanged="OnSliderChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="Hotkeys" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <CheckBox x:Name="HotkeysBox" Content="Global hotkeys" Style="{StaticResource ToggleSwitch}" Click="OnChanged" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,10"
                               Text="They work while a game has focus, and only these exact combinations are taken. Click a box and press a new one (Ctrl, Alt or Win plus a key). Backspace turns one off; Esc cancels." />
                    <StackPanel x:Name="HotkeyRows" />
                </StackPanel>
            </Border>

            <TextBlock Text="System" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <CheckBox x:Name="AutostartBox" Content="Start with Windows" Style="{StaticResource ToggleSwitch}" Click="OnChanged" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Click-through: the hotkey above, or the tray menu. While it's on, clicks pass to whatever is underneath; a left click on the tray icon turns it off." />
                </StackPanel>
            </Border>

            <TextBlock Text="Mac link" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <CheckBox x:Name="LinkBox" Content="Allow control from my Mac" Style="{StaticResource ToggleSwitch}" Click="OnLinkToggled" />
                    <TextBlock x:Name="LinkStatusText" Style="{StaticResource Hint}" Margin="0,8,0,0" />

                    <StackPanel x:Name="LinkDetails" Margin="0,12,0,0">
                        <Border x:Name="PairPanel" Background="#14FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="On your Mac, run:" />
                                <TextBox x:Name="PairCommand" Style="{StaticResource FieldBox}" IsReadOnly="True" Margin="0,6,0,6" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource PillButton}" Height="28" Click="OnCancelPairing" />
                                    <TextBlock x:Name="PairCountdown" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PairButton" Content="Pair a Mac…" Style="{StaticResource PillButton}" Click="OnPair" />
                            <Button x:Name="FirewallButton" Content="Allow through firewall…" Style="{StaticResource PillButton}" Margin="8,0,0,0" Click="OnFirewall" />
                        </StackPanel>
                        <TextBlock x:Name="FirewallText" Style="{StaticResource Hint}" Margin="0,8,0,0" />

                        <TextBlock Text="Paired" Style="{StaticResource Label}" Margin="0,16,0,6" />
                        <StackPanel x:Name="DeviceList" />

                        <TextBlock Text="Recent activity" Style="{StaticResource Label}" Margin="0,16,0,6" />
                        <TextBlock x:Name="ContextText" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                        <TextBlock x:Name="ActivityText" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{StaticResource InkMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10"
                               Text="Playback from the Spotify Web API (read-only). Lyrics from LRCLIB. Built on spotify-lyrics-overlay-wpf (MIT)." />
                    <Button Content="Open data folder" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Click="OnOpenData" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
