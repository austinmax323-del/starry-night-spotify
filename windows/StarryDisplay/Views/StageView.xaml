<UserControl x:Class="StarryDisplay.Views.StageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Ideal">
    <Grid x:Name="Card">
        <!-- Background stack: night base, soft artwork glow, legibility veil, static stars, hairline. -->
        <Rectangle x:Name="BaseFill" Fill="{StaticResource NightBrush}" />
        <Grid x:Name="BackdropLayer" Opacity="0.6">
            <Image x:Name="BackA" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0" />
            <Image x:Name="BackB" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0" />
        </Grid>
        <Rectangle x:Name="Veil">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                    <GradientStop Color="#590A0D18" Offset="0" />
                    <GradientStop Color="#A60A0D18" Offset="0.45" />
                    <GradientStop Color="#D90A0D18" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="Stars" Opacity="0.55" />
        <Border x:Name="Hairline" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="22" />

        <!-- Live content -->
        <Grid x:Name="LiveContent" Margin="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ArtColumn" Width="Auto" />
                <ColumnDefinition x:Name="GapColumn" Width="30" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="ArtBox" VerticalAlignment="Center">
                <Border x:Name="ArtFrame" CornerRadius="14" Background="#14FFFFFF">
                    <Grid>
                        <TextBlock x:Name="ArtPlaceholder" Style="{StaticResource IconText}" Text="&#xE8D6;"
                                   FontSize="56" Foreground="{StaticResource InkMutedBrush}" Opacity="0.6" />
                        <Image x:Name="ArtA" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0" />
                        <Image x:Name="ArtB" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0" />
                    </Grid>
                </Border>
                <Border CornerRadius="14" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" />
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="Meta" Margin="0,2,0,0">
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                               FontSize="30" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ArtistText" FontFamily="{StaticResource TextFont}" FontSize="17" Margin="0,3,0,0"
                               Foreground="{StaticResource InkSoftBrush}" TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="ChipRow" Orientation="Horizontal" Margin="0,12,0,0">
                        <Border x:Name="DeviceChip" Style="{StaticResource Chip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DeviceGlyph" Style="{StaticResource IconText}" FontSize="11" Margin="0,1,6,0" />
                                <TextBlock x:Name="DeviceText" FontFamily="{StaticResource TextFont}" FontSize="12" Foreground="{StaticResource InkSoftBrush}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="StateChip" Style="{StaticResource Chip}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="StateGlyph" Style="{StaticResource IconText}" FontSize="10" Margin="0,1,6,0" Foreground="{StaticResource InkSoftBrush}" />
                                <TextBlock x:Name="StateText" FontFamily="{StaticResource TextFont}" FontSize="12" Foreground="{StaticResource InkSoftBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="AlbumText" FontFamily="{StaticResource TextFont}" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource InkMutedBrush}" TextTrimming="CharacterEllipsis" Margin="2,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border x:Name="LyricsHost" Grid.Row="1" Margin="0,18,0,16" />

                <Grid x:Name="ProgressBlock" Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Height="4">
                        <Border CornerRadius="2" Background="{StaticResource TrackBrush}" />
                        <Border x:Name="ProgressFill" CornerRadius="2" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock x:Name="ElapsedText" FontFamily="{StaticResource TextFont}" FontSize="12"
                                   Foreground="{StaticResource InkMutedBrush}" Typography.NumeralAlignment="Tabular" />
                        <TextBlock x:Name="PlayGlyph" Style="{StaticResource IconText}" FontSize="10" Foreground="{StaticResource InkMutedBrush}" />
                        <TextBlock x:Name="TotalText" FontFamily="{StaticResource TextFont}" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{StaticResource InkMutedBrush}" Typography.NumeralAlignment="Tabular" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- States without live playback: nothing playing, connecting, private, offline before first track. -->
        <StackPanel x:Name="StatusPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False" MaxWidth="460">
            <TextBlock x:Name="StatusGlyph" Style="{StaticResource IconText}" FontSize="30" Foreground="{StaticResource InkSoftBrush}" Text="&#xE708;" />
            <TextBlock x:Name="StatusTitle" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="24"
                       Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock x:Name="StatusDetail" FontFamily="{StaticResource TextFont}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{StaticResource InkMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <TextBlock x:Name="LastPlayed" FontFamily="{StaticResource TextFont}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource InkMutedBrush}" HorizontalAlignment="Center" Margin="0,18,0,0" Opacity="0.75" />
        </StackPanel>
    </Grid>
</UserControl>
